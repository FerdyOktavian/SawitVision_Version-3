# SawitVision V3 backend environment contract.
# Copy to backend/.env for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# REQUIRED in Railway. Values: development, staging, production, test.
APP_ENV=development
# OPTIONAL. Railway supplies PORT automatically; local fallback is 8000.
PORT=8000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# REQUIRED, SECRET. Supabase PostgreSQL connection string, not the Storage URL.
DATABASE_URL=
# OPTIONAL. Conservative defaults for one Railway worker.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# OPTIONAL. Keep require for Supabase unless certificate verification is set up.
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# REQUIRED, SECRET. Production requires at least 32 characters.
JWT_SECRET_KEY=
# OPTIONAL. Allowed: HS256, HS384, HS512.
JWT_ALGORITHM=HS256
# OPTIONAL. Default is seven days.
JWT_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# REQUIRED in production. Exact comma-separated frontend origins, no wildcard,
# path, query, fragment, credential, or trailing slash.
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Supabase Storage
# -----------------------------------------------------------------------------
# REQUIRED in production. Supabase project API/Storage URL, not DATABASE_URL.
SUPABASE_URL=
# REQUIRED in production, SECRET, backend-only. Never expose through VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL, SECRET fallback. Prefer the service-role variable above.
SUPABASE_KEY=
# OPTIONAL.
SUPABASE_BUCKET=sawitvision-v3-images

# -----------------------------------------------------------------------------
# AI Runtime
# -----------------------------------------------------------------------------
# OPTIONAL. auto selects CUDA when available, otherwise CPU.
AI_DEVICE=auto
# OPTIONAL inference contract values.
YOLO_IMGSZ=640
YOLO_CONFIDENCE=0.40
YOLO_IOU=0.50
AI_MIN_CROP_SIZE=8
DINO_BATCH_SIZE=8
AI_USE_AMP=true
AI_VERIFY_MODEL_SHA256=true
AI_ANNOTATE_DETECTOR_CONFIDENCE=false

# -----------------------------------------------------------------------------
# AI Model Acquisition
# -----------------------------------------------------------------------------
# OPTIONAL. Shared local directory, useful for a Railway volume at /models.
AI_MODEL_DIR=
# OPTIONAL explicit paths. They override AI_MODEL_DIR when supplied.
YOLO_MODEL_PATH=
DINO_CHECKPOINT_PATH=
# CONDITIONALLY REQUIRED when no valid local artifact exists. Direct HTTPS
# download URLs from Hugging Face or any compatible artifact host are allowed.
YOLO_MODEL_URL=
DINO_CHECKPOINT_URL=
# REQUIRED integrity contract; non-secret locked V1 hashes.
YOLO_MODEL_SHA256=0ea20e9dfa6ef65f41c9f4f8125268d464662da204ff0021e483381b7138d9bf
DINO_CHECKPOINT_SHA256=ff9c87057d70853aaf9e68e51242c470a83ba3d34fba8efe09ea8dfc98f15c94
# OPTIONAL, SECRET. Sent as Bearer token when the artifact host supports it.
AI_MODEL_DOWNLOAD_TOKEN=
# OPTIONAL. Valid range 1-3600 seconds.
AI_MODEL_DOWNLOAD_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Geocoding
# -----------------------------------------------------------------------------
# OPTIONAL. Reverse geocoding remains non-blocking for prediction.
GEOCODING_ENABLED=true
GEOCODING_PROVIDER=nominatim
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=SawitVisionV3/1.0
GEOCODING_LANGUAGE=id

# -----------------------------------------------------------------------------
# Security / Rate Limiting
# -----------------------------------------------------------------------------
# OPTIONAL. Leave empty: enabled outside production, disabled in production.
# Current name+phone auth is intended only for private development/staging.
ALLOW_INSECURE_IDENTITY_AUTH=
# OPTIONAL. Leave empty: enabled outside production, disabled in production.
ENABLE_API_DOCS=
# OPTIONAL. In-memory and per process; keep enabled for single-worker staging.
RATE_LIMIT_ENABLED=true
# OPTIONAL. Enable only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# Operational
# -----------------------------------------------------------------------------
# OPTIONAL.
LOG_LEVEL=INFO
APP_STORAGE_LIMIT_GB=1
MIN_SAVE_CONFIDENCE=70

# Legacy EfficientNet/Hugging Face variables are intentionally omitted from
# production. requirements.txt and model_downloader.py are rollback-only.
